[Unit]
Description=OCI AI Gateway instance signing service
Requires=oci-ai-gateway-signing.socket
After=oci-ai-gateway-signing.socket network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/oci-ai-gateway
ExecStart=/opt/oci-ai-gateway/oci-cli/bin/python -m runtime.oci_signing_entrypoint
NonBlocking=yes
Restart=on-failure
RestartSec=5
TimeoutStopSec=5
KillMode=control-group
UMask=0077
StandardOutput=null
StandardError=journal
