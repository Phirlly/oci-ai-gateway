+class _OCISyncEvents:
+    """Validate EOF while preserving explicit close, including before first read."""
+
+    def __init__(self, events, require_finish, response=None):
+        self.response = response
+        self.events = iter(events)
+        self.require_finish = require_finish
+        self.closed = False
+
+    def __iter__(self):
+        return self
+
+    def __next__(self):
+        try:
+            return next(self.events)
+        except StopIteration:
+            self.require_finish()
+            raise
+
+    def close(self):
+        if not self.closed:
+            self.closed = True
+            try:
+                close = getattr(self.events, "close", None)
+                if close is not None:
+                    close()
+            finally:
+                if self.response is not None:
+                    self.response.close()
+
+
+class _OCIAsyncEvents:
+    """Async EOF validation and idempotent upstream cleanup."""
+
+    def __init__(self, events, require_finish, response=None):
+        self.response = response
+        self.events = events.__aiter__()
+        self.require_finish = require_finish
+        self.closed = False
+
+    def __aiter__(self):
+        return self
+
+    async def __anext__(self):
+        try:
+            return await self.events.__anext__()
+        except StopAsyncIteration:
+            self.require_finish()
+            raise
+
+    async def aclose(self):
+        if not self.closed:
+            self.closed = True
+            try:
+                close = getattr(self.events, "aclose", None)
+                if close is not None:
+                    await close()
+            finally:
+                if self.response is not None:
+                    await self.response.aclose()
+
