+def _normalize_oci_finish_reason(raw: str | None) -> str | None:
+    """Normalize known terminal reasons; never turn an aborted answer into stop."""
+    if raw is None:
+        return None  # Intermediate deltas need not carry a finish reason.
+    if raw in ("COMPLETE", "STOP", "stop"):
+        return "stop"
+    if raw in ("MAX_TOKENS", "length"):
+        return "length"
+    if raw in ("TOOL_CALL", "TOOL_CALLS", "tool_calls"):
+        return "tool_calls"
+    raise OCIError(status_code=502, message="OCI returned an unsuccessful completion ending.")
 
 
